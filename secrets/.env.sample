GMAIL_TOKEN_DIRECTORY=/app/data/gmail
GMAIL_AUTH_CALLBACK_BASE_URL=http://<Your PC IP address>:9999

UNSCHEDULED_GARBAGE_COLLECTION_SENDER=<user>@<domain>.<com>